+        char buf[16];
+        if (!init_second_stage_executed && check_argv(*argv, 1, "--second-stage", buf, sizeof(buf))) {
+            /* This applies to versions between Android 6 ~ 7 */
+            pr_info("ksud: /init second_stage executed\n");
+            apply_kernelsu_rules();
+            cache_sid();
+            setup_ksu_cred();

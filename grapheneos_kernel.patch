diff --git a/EXTRA/KernelSU/kernel/preinit/runner/nolibc/sys/mman.h b/EXTRA/KernelSU/kernel/preinit/runner/nolibc/sys/mman.h
new file mode 100644
index 00000000..5228751b
--- /dev/null

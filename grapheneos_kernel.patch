diff --git a/EXTRA/KernelSU/kernel/Makefile b/EXTRA/KernelSU/kernel/Makefile
new file mode 100644
index 00000000..bed47b88
--- /dev/null
+++ b/EXTRA/KernelSU/EXTRA/KernelSU/kernel/Makefile
@@ -0,0 +1,203 @@
+obj-$(CONFIG_KSU) := ksu.o
+ksu-y := ksu_main.o
+
+ccflags-y += -I$(srctree)/security/selinux -I$(srctree)/security/selinux/include
+ccflags-y += -I$(objtree)/security/selinux -include $(srctree)/include/uapi/asm-generic/errno.h
+
+ifeq ($(filter /%,$(src)),)
+KSU_KERNEL_DIR := $(srctree)/$(src)
+else
+KSU_KERNEL_DIR := $(src)
+endif
+
+ifeq ($(CONFIG_KSU_SUSFS), y)
+## As we are building gki only, no KBUILD_EXTMOD is needed
+## Since there is still a build error for 6.12 as $(src) returns absolute path, so here we just hardcode it
+ccflags-y += -I$(srctree)/drivers/kernelsu -I$(srctree)/drivers/kernelsu/include
+else
+ccflags-y += -I$(KSU_KERNEL_DIR) -I$(KSU_KERNEL_DIR)/include
+endif
+
+MDIR    := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
+
+# ===== preinit runner =====
+KSU_UAPI_INC := $(objtree)/usr/include
+ifneq ($(wildcard $(KSU_UAPI_INC)/linux/unistd.h),)
+ksu-y += preinit/preinit.o preinit/blob.o
+
+KSU_RUNNER_CFLAGS := $(CLANG_FLAGS) -std=gnu11 -Os -Wall \
+	-nostdinc -isystem $(shell $(CC) -print-file-name=include) \
+	-I$(KSU_KERNEL_DIR)/preinit/runner/nolibc -I$(KSU_UAPI_INC) \
+	-I$(KSU_KERNEL_DIR)/include \
+	-ffreestanding -fno-stack-protector -fno-pic -fno-pie \
+	-fno-asynchronous-unwind-tables -fno-unwind-tables \
+	-ffunction-sections -fdata-sections
+
+quiet_cmd_ksu_runner = RUNNER  $@
+      cmd_ksu_runner = $(CC) $(KSU_RUNNER_CFLAGS) -c -o $@.o $< && \
+		$(LD) -static -nostdlib -e _start --gc-sections -s -o $@ $@.o && \
+		rm -f $@.o
+
+$(obj)/preinit/runner.elf: $(KSU_KERNEL_DIR)/preinit/runner/runner.c \
+		$(wildcard $(KSU_KERNEL_DIR)/preinit/runner/nolibc/*.h \
+			   $(KSU_KERNEL_DIR)/preinit/runner/nolibc/sys/*.h \
+			   $(KSU_KERNEL_DIR)/include/uapi/*.h) FORCE
+	$(call if_changed,ksu_runner)
+
+targets += preinit/runner.elf
+
+$(obj)/preinit/blob.o: $(obj)/preinit/runner.elf
+asflags-y += -DKSU_PREINIT_RUNNER_BIN=\"$(abspath $(obj)/preinit/runner.elf)\"
+
+else
+$(warning -- KernelSU: $(KSU_UAPI_INC) not found, preinit disabled)
+ccflags-y += -DKSU_NO_PREINIT
+endif
+# ===== end preinit runner =====
+
+REPO_OWNER  := SukiSU-Ultra
+REPO_NAME   := SukiSU-Ultra
+REPO_BRANCH := main
+
+VERSION_BASE    := 40000
+VERSION_OFFSET  := 2815
+
+GIT_BIN  := /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin git
+CURL_BIN := /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin curl
+
+KSU_SRC := $(if $(filter $(srctree),$(src)),$(src),$(srctree)/$(src))
+KSU_SRC := $(if $(wildcard $(KSU_SRC)/../.git),$(KSU_SRC),$(MDIR))
+
+git_short_sha    = $(shell cd $(KSU_SRC) && $(GIT_BIN) rev-parse --short=8 HEAD 2>/dev/null)
+git_branch       = $(shell cd $(KSU_SRC) && $(GIT_BIN) rev-parse --abbrev-ref HEAD 2>/dev/null)
+git_commit_count = $(shell cd $(KSU_SRC) && $(GIT_BIN) rev-list --count $(REPO_BRANCH) 2>/dev/null)
+git_latest_tag   = $(shell cd $(KSU_SRC) && $(GIT_BIN) describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
+
+$(shell cd $(KSU_SRC) 2>/dev/null && [ -f ../.git/shallow ] && $(GIT_BIN) fetch --unshallow 2>/dev/null)
+
+GITHUB_API_BASE  := https://api.github.com/repos/$(REPO_OWNER)/$(REPO_NAME)
+KSU_GITHUB_VER   := $(shell $(CURL_BIN) -s "$(GITHUB_API_BASE)/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"v?([^"]+)".*/\1/')
+GITHUB_COMMITS   := $(shell $(CURL_BIN) -sI "$(GITHUB_API_BASE)/commits?sha=$(REPO_BRANCH)&per_page=1" 2>/dev/null | grep -i "link:" | sed -n 's/.*page=\([0-9]*\)>; rel="last".*/\1/p')
+LOCAL_COUNT     := $(if $(GITHUB_COMMITS),$(GITHUB_COMMITS),$(git_commit_count))
+KSU_VERSION     := $(if $(LOCAL_COUNT),$(shell expr $(VERSION_BASE) + $(LOCAL_COUNT) - $(VERSION_OFFSET)),13000)
+VERSION_TAG     := $(or $(KSU_GITHUB_VER),$(git_latest_tag),4.2.1)
+KSU_VERSION_FULL := $(if $(call git_short_sha),v$(VERSION_TAG)-$(call git_short_sha)@$(call git_branch),v$(VERSION_TAG)-$(REPO_NAME)-unknown@unknown)
+$(info -- $(REPO_NAME) version: $(KSU_VERSION) [$(KSU_VERSION_FULL)])
+
+ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
+ccflags-y += -DKSU_VERSION_FULL=\"$(KSU_VERSION_FULL)\"
+
+KERNEL_VERSION := $(VERSION).$(PATCHLEVEL)
+KERNEL_TYPE := Non-GKI
+# Check for GKI 2.0 (5.10+ or 6.x+)
+ifneq ($(shell test \( $(VERSION) -ge 5 -a $(PATCHLEVEL) -ge 10 \) -o $(VERSION) -ge 6; echo $$?),0)
+# Check for GKI 1.0 (5.4)
+ifeq ($(shell test $(VERSION)-$(PATCHLEVEL) = 5-4; echo $$?),0)
+KERNEL_TYPE := GKI 1.0
+endif
+else
+KERNEL_TYPE := GKI 2.0
+endif
+$(info -- KERNEL_VERSION: $(KERNEL_VERSION))
+$(info -- KERNEL_TYPE: $(KERNEL_TYPE))
+
+ifeq ($(CONFIG_KSU_SUSFS), y)
+$(info -- $(REPO_NAME): using SUSFS_INLINE_HOOK)
+else
+$(info -- $(REPO_NAME): using Unknown)
+endif
+
+ifeq ($(CONFIG_KPM), y)
+$(info -- KPM is enabled)
+else
+$(info -- KPM is disabled)
+endif
+
+# Check new vfs_getattr()
+ifeq ($(shell grep -A1 "^int vfs_getattr" $(srctree)/fs/stat.c | grep -q "query_flags" ; echo $$?),0)
+ccflags-y += -DKSU_HAS_NEW_VFS_GETATTR
+endif
+
+ifeq ($(shell grep -q " current_sid(void)" $(srctree)/security/selinux/include/objsec.h; echo $$?),0)
+ccflags-y += -DKSU_COMPAT_HAS_CURRENT_SID
+endif
+
+ifeq ($(shell grep -q "struct selinux_state " $(srctree)/security/selinux/include/security.h; echo $$?),0)
+ccflags-y += -DKSU_COMPAT_HAS_SELINUX_STATE
+endif
+
+ifeq ($(shell grep -q "strncpy_from_user_nofault" $(srctree)/include/linux/uaccess.h; echo $$?),0)
+ccflags-y += -DKSU_HAS_STRNCPY_FROM_USER_NOFAULT
+endif
+
+ifeq ($(shell grep -q "atomic_t\s\+filter_count" $(srctree)/include/linux/seccomp.h; echo $$?),0)
+ccflags-y += -DKSU_OPTIONAL_SECCOMP_FILTER_CNT
+endif
+
+# some old kernel backport this, check if put_seccomp_filter still exist
+ifneq ($(shell grep -wq "put_seccomp_filter" $(srctree)/kernel/seccomp.c $(srctree)/include/linux/seccomp.h; echo $$?),0)
+ifeq ($(shell grep -wq "seccomp_filter_release" $(srctree)/kernel/seccomp.c $(srctree)/include/linux/seccomp.h; echo $$?),0)
+ccflags-y += -DKSU_OPTIONAL_SECCOMP_FILTER_RELEASE
+endif
+endif
+
+ifeq ($(shell grep -q "^DEFINE_RWLOCK(policy_rwlock);" $(srctree)/security/selinux/ss/services.c; echo $$?),0)
+ccflags-y += -DKSU_COMPAT_HAS_EXPORTED_POLICY_RWLOCK
+endif
+
+ifeq ($(shell grep -q "cpus_ptr;" $(srctree)/include/linux/sched.h; echo $$?),0)
+ccflags-y += -DKSU_COMPAT_HAS_BACKPORTED_CPUS_PTR
+endif
+
+ifeq ($(shell grep -q "selinux_inode" $(srctree)/security/selinux/include/objsec.h; echo $$?),0)
+ccflags-y += -DKSU_HAS_SELINUX_INODE
+endif
+
+ifeq ($(shell grep -q "selinux_cred" $(srctree)/security/selinux/include/objsec.h; echo $$?),0)
+ccflags-y += -DKSU_HAS_SELINUX_CRED
+endif
+
+ifeq ($(shell grep -q "struct type_datum \*\*type_val_to_struct;" $(srctree)/security/selinux/ss/policydb.h; echo $$?),0)
+ccflags-y += -DKSU_TYPE_VAL_TO_STRUCT
+endif
+
+# half-assed-backport from 5.1
+ifeq ($(shell grep -q "struct type_datum \*\*type_val_to_struct_array;" $(srctree)/security/selinux/ss/policydb.h; echo $$?),0)
+ccflags-y += -DKSU_TYPE_VAL_TO_STRUCT_ARRAY
+endif
+
+# https://github.com/torvalds/linux/commit/11276d5306b8e5b438a36bbff855fe792d7eaa61
+ifeq ($(shell grep -q "DEFINE_STATIC_KEY_TRUE" $(srctree)/include/linux/jump_label.h 2>/dev/null; echo $$?),0)
+$(info -- $(REPO_NAME)/compat: modern static_key_interface found)
+ccflags-y += -DKSU_HAS_MODERN_STATIC_KEY_INTERFACE
+endif
+
+# Vendor backports may change these fields independently of LINUX_VERSION_CODE.
+# Inspect the actual target source header, not the host kernel or KMI label.
+ksu_netlink_cfg := $(shell sed -n '/struct netlink_kernel_cfg {/,/^};/p' $(srctree)/include/linux/netlink.h)
+ifneq ($(findstring cb_mutex,$(ksu_netlink_cfg)),)
+ccflags-y += -DKSU_NETLINK_CFG_HAS_CB_MUTEX=1
+endif
+ifneq ($(findstring compare,$(ksu_netlink_cfg)),)
+ccflags-y += -DKSU_NETLINK_CFG_HAS_COMPARE=1
+endif
+
+KSU_PACKAGE_NAME ?= com.sukisu.ultra
+
+ccflags-y += -DKSU_PACKAGE_NAME=\"$(KSU_PACKAGE_NAME)\"
+
+## For susfs stuff ##
+ifeq ($(shell test -e $(srctree)/fs/susfs.c; echo $$?),0)
+$(eval SUSFS_VERSION=$(shell cat $(srctree)/include/linux/susfs.h | grep -E '^#define SUSFS_VERSION' | cut -d' ' -f3 | sed 's/"//g'))
+$(info )
+$(info -- SUSFS_VERSION: $(SUSFS_VERSION))
+else
+$(info -- You have not integrated susfs in your kernel yet.)
+$(info -- Read: https://gitlab.com/simonpunk/susfs4ksu)
+endif
+
+ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes
+ccflags-y += -Wno-declaration-after-statement -Wno-unused-function
+
+
+# Keep a new line here!! Because someone may append config
diff --git a/EXTRA/KernelSU/kernel/extension/cpu_spoof.c b/EXTRA/KernelSU/kernel/extension/cpu_spoof.c
new file mode 100644
index 00000000..0007c2fd
--- /dev/null
+++ b/EXTRA/KernelSU/EXTRA/KernelSU/kernel/extension/cpu_spoof.c
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CPU spoof extension. io-only: ops = NULL, no sticky enable bit.
+ *
+ * GET  -> supported=true, value=0 (handler presence is the signal).
+ * SET  -> -EOPNOTSUPP (no sticky bit).
+ * IO   -> MIDR/lpj/hwcap/vDSO rewrite via userspace ksu_set_spoof_cpu_cmd.
+ *
+ * Forced-by-config is not wired: a force_extension=cpu_spoof:N entry
+ * is rejected with a dmesg warning and clears the forced-pending bit.
+ * The default force semantics are not obvious (per-device MIDR).
+ */
+#include <linux/kernel.h>
+#include <linux/types.h>
+#include <linux/cpumask.h>
+#include <linux/percpu.h>
+#include <linux/jiffies.h>
+#include <linux/delay.h>
+#include <linux/clocksource.h>
+#include <linux/errno.h>
+#include <linux/uaccess.h>
+#include <linux/version.h>
+
+
+#if defined(CONFIG_ARM64) || defined(__aarch64__)
+#include <asm/cpu.h>
+#include <asm/cputype.h>
+#include <asm/cpufeature.h>
+#include <vdso/datapage.h>
+#include <vdso/clocksource.h>
+
+#ifndef MIDR_PARTNUM_SHIFT
+#define MIDR_PARTNUM_SHIFT 4
+#endif
+
+#ifndef MIDR_PARTNUM_MASK
+#define MIDR_PARTNUM_MASK (0xfff << MIDR_PARTNUM_SHIFT)
+#endif
+
+#ifndef MIDR_PARTNUM
+#define MIDR_PARTNUM(midr) (((midr) & MIDR_PARTNUM_MASK) >> MIDR_PARTNUM_SHIFT)
+#endif
+
+#ifndef ARM_CPU_PART_NEOVERSE_N1
+#define ARM_CPU_PART_NEOVERSE_N1 0xd0c
+#endif
+
+#ifndef ARM_CPU_PART_CORTEX_A76
+#define ARM_CPU_PART_CORTEX_A76 0xd0b
+#endif
+
+#ifndef QCOM_CPU_PART_KRYO_4XX_GOLD
+#define QCOM_CPU_PART_KRYO_4XX_GOLD 0x804
+#endif
+
+#ifndef CS_HRES_COARSE
+#define CS_HRES_COARSE 0
+#endif
+
+#ifndef CS_RAW
+#define CS_RAW 1
+#endif
+
+#ifndef VDSO_CLOCKMODE_ARCHTIMER
+#define VDSO_CLOCKMODE_ARCHTIMER 1
+#endif
+
+#ifndef ARM64_WORKAROUND_1418040
+#define ARM64_WORKAROUND_1418040 37
+#endif
+
+#endif
+
+static int set_spoof_cpu(const struct ksu_set_spoof_cpu_cmd *cmd)
+{
+    int missing = 0;
+
+    if (!cmd)
+        return -EINVAL;
+
+    if (cmd->cpu_index >= num_possible_cpus()) {
+        pr_warn("ksu: set_spoof_cpu out-of-bounds cpu_index %u\n",
+                cmd->cpu_index);
+        return -EINVAL;
+    }
+
+#if defined(CONFIG_ARM64) || defined(__aarch64__)
+    {
+        unsigned long cpu_data_base = find_kernel_symbol_exact("cpu_data");
+        if (cpu_data_base) {
+            struct cpuinfo_arm64 *info =
+                per_cpu_ptr((struct cpuinfo_arm64 *)cpu_data_base,
+                            cmd->cpu_index);
+            if (info) {
+                info->reg_midr = cmd->midr;
+            } else {
+                pr_warn("ksu: set_spoof_cpu per_cpu_ptr failed for cpu_index %u\n",
+                        cmd->cpu_index);
+                ++missing;
+            }
+        } else {
+            pr_warn("ksu: set_spoof_cpu failed to resolve 'cpu_data'\n");
+            ++missing;
+        }
+    }
+
+    if (cmd->cpu_index == 0) {
+        unsigned long *lpj =
+            (unsigned long *)find_kernel_symbol_exact("loops_per_jiffy");
+        if (lpj) {
+            *lpj = ((unsigned long)cmd->bogomips * 500000) / (100 * HZ);
+        } else {
+            pr_warn("ksu: set_spoof_cpu failed to resolve 'loops_per_jiffy'\n");
+            ++missing;
+        }
+
+        unsigned long *elf_hwcap_bitmap =
+            (unsigned long *)find_kernel_symbol_exact("elf_hwcap");
+        if (elf_hwcap_bitmap) {
+            elf_hwcap_bitmap[0] = cmd->hwcap;
+            elf_hwcap_bitmap[1] = cmd->hwcap2;
+        } else {
+            pr_warn("ksu: set_spoof_cpu failed to resolve 'elf_hwcap'\n");
+            ++missing;
+        }
+
+        {
+            unsigned int part = MIDR_PARTNUM(cmd->midr);
+            if (part != ARM_CPU_PART_NEOVERSE_N1 &&
+                part != ARM_CPU_PART_CORTEX_A76 &&
+                part != QCOM_CPU_PART_KRYO_4XX_GOLD) {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+                struct vdso_time_data **vdso_time_data_ptr =
+                    (struct vdso_time_data **)find_kernel_symbol_exact(
+                        "vdso_time_data");
+                if (!vdso_time_data_ptr)
+                    vdso_time_data_ptr =
+                        (struct vdso_time_data **)find_kernel_symbol_exact(
+                            "_vdso_time_data");
+                if (!vdso_time_data_ptr)
+                    vdso_time_data_ptr =
+                        (struct vdso_time_data **)find_kernel_symbol_exact(
+                            "vdso_data");
+                if (vdso_time_data_ptr && *vdso_time_data_ptr) {
+                    struct vdso_time_data *vdso = *vdso_time_data_ptr;
+                    vdso->clock_data[CS_HRES_COARSE].clock_mode =
+                        VDSO_CLOCKMODE_ARCHTIMER;
+                    vdso->clock_data[CS_RAW].clock_mode =
+                        VDSO_CLOCKMODE_ARCHTIMER;
+                } else {
+                    pr_warn("ksu: set_spoof_cpu failed to resolve vDSO time data\n");
+                    ++missing;
+                }
+#else
+                struct vdso_data **vdso_data_ptr =
+                    (struct vdso_data **)find_kernel_symbol_exact("vdso_data");
+                if (vdso_data_ptr && *vdso_data_ptr) {
+                    struct vdso_data *vdso = *vdso_data_ptr;
+                    vdso[CS_HRES_COARSE].clock_mode =
+                        VDSO_CLOCKMODE_ARCHTIMER;
+                    vdso[CS_RAW].clock_mode = VDSO_CLOCKMODE_ARCHTIMER;
+                } else {
+                    pr_warn("ksu: set_spoof_cpu failed to resolve 'vdso_data'\n");
+                    ++missing;
+                }
+#endif
+
+                {
+                    struct clocksource **curr_cs_ptr =
+                        (struct clocksource **)find_kernel_symbol_exact(
+                            "curr_clocksource");
+                    if (curr_cs_ptr && *curr_cs_ptr) {
+                        (*curr_cs_ptr)->vdso_clock_mode =
+                            VDSO_CLOCKMODE_ARCHTIMER;
+                    } else {
+                        pr_warn("ksu: set_spoof_cpu failed to resolve 'curr_clocksource'\n");
+                        ++missing;
+                    }
+                }
+
+                {
+                    enum vdso_clock_mode *vd_default =
+                        (enum vdso_clock_mode *)find_kernel_symbol_exact(
+                            "vdso_default");
+                    if (vd_default) {
+                        *vd_default = VDSO_CLOCKMODE_ARCHTIMER;
+                    } else {
+                        pr_warn("ksu: set_spoof_cpu failed to resolve 'vdso_default'\n");
+                        ++missing;
+                    }
+                }
+
+                {
+                    unsigned long *caps =
+                        (unsigned long *)find_kernel_symbol_exact("cpu_hwcaps");
+                    if (!caps)
+                        caps = (unsigned long *)find_kernel_symbol_exact(
+                            "system_cpucaps");
+                    if (caps) {
+                        clear_bit(ARM64_WORKAROUND_1418040, caps);
+                    } else {
+                        pr_warn("ksu: set_spoof_cpu failed to resolve 'cpu_hwcaps' / 'system_cpucaps'\n");
+                        ++missing;
+                    }
+                }
+            }
+        }
+    }
+#endif
+
+    /*
+     * If any of the kallsyms lookups failed, refuse to claim success.
+     * Previously the function silently returned 0 even when none of
+     * the writes had taken effect, which made callers (and users)
+     * think CPU spoof was active when only partial — or no —
+     * rewrites had happened. -ENXIO distinguishes "subsystem
+     * missing on this build" from a generic -EINVAL.
+     */
+    if (missing) {
+        pr_warn("ksu: set_spoof_cpu for cpu %u incomplete (%d symbol(s) unresolved)\n",
+                cmd->cpu_index, missing);
+        return -ENXIO;
+    }
+
+    pr_info("KernelSU Stealth: CPU %u identity spoofed (MIDR: 0x%08x)\n",
+            cmd->cpu_index, cmd->midr);
+    return 0;
+}
+
+int ksu_extension_cpu_spoof_io(u32 id, void __user *raw)
+{
+    struct ksu_set_spoof_cpu_cmd cmd;
+
+    if (copy_from_user(&cmd, raw, sizeof(cmd)))
+        return -EFAULT;
+
+    return set_spoof_cpu(&cmd);
+}

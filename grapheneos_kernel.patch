-static void generate_file_content(char *content, size_t size)
-{
-	srand(time(NULL));
-	/* Generate only printable characters in the range of [32, 126] */
-	for (size_t i = 0; i < size; i++)
-		content[i] = 32 + rand() % 95;
-}

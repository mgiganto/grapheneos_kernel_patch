+++ b/EXTRA/KernelSU/EXTRA/KernelSU/kernel/preinit/common/runner/small_rt.h
@@ -0,0 +1,183 @@
+#pragma once
+#include <sys/syscall.h>
+
+// hint: -Wl,--entry=__start
+#ifndef asm
+#define asm __asm__
+#endif
+
+// syscall de-wrappers
+#if defined(__aarch64__)
+__attribute__((always_inline, noipa))
+static long __syscall_raw(long n, long a, long b, long c, long d, long e, long f)
+{
+	register long 
+		x8 asm("x8") = n,
+		x0 asm("x0") = a,
+		x1 asm("x1") = b,
+		x2 asm("x2") = c,
+		x3 asm("x3") = d,
+		x4 asm("x4") = e,
+		x5 asm("x5") = f;
+
+	asm volatile("svc #0"
+		:"=r"(x0)
+		:"r"(x8), "r"(x0), "r"(x1), "r"(x2), "r"(x3), "r"(x4), "r"(x5)
+		:"memory");
+
+	return x0;
+}
+
+#elif defined(__arm__)
+__attribute__((always_inline, noipa))
+static long __syscall_raw(long n, long a, long b, long c, long d, long e, long f)
+{
+	register long
+		r7 asm("r7") = n,
+		r0 asm("r0") = a,
+		r1 asm("r1") = b,
+		r2 asm("r2") = c,
+		r3 asm("r3") = d,
+		r4 asm("r4") = e,
+		r5 asm("r5") = f;
+
+	asm volatile("svc #0"
+		: "=r"(r0)
+		: "r"(r7), "r"(r0), "r"(r1), "r"(r2), "r"(r3), "r"(r4), "r"(r5)
+		: "memory");
+
+	return r0;
+}
+
+#elif defined(__x86_64__)
+__attribute__((always_inline, noipa))
+static long __syscall_raw(long n, long a, long b, long c, long d, long e, long f)
+{
+	long ret;
+	asm volatile(
+		"mov %5, %%r10\n"
+		"mov %6, %%r8\n"
+		"mov %7, %%r9\n"
+		"syscall"
+		: "=a"(ret)
+		: "a"(n), "D"(a), "S"(b), "d"(c), "r"(d), "r"(e), "r"(f)
+		: "rcx", "r11", 
+		"memory");
+
+	return ret;
+}
+
+#elif defined(__i386__)
+__attribute__((always_inline, noipa))
+static long __syscall_raw(long n, long a, long b, long c, long d, long e, long f)
+{
+	long _eax = (long)(n);
+	long _arg6 = (long)(f);
+	__asm__ volatile (
+		"pushl	%[_arg6]\n\t"
+		"pushl	%%ebp\n\t"
+		"movl	4(%%esp),%%ebp\n\t"
+		"int	$0x80\n\t"
+		"popl	%%ebp\n\t"
+		"addl	$4,%%esp\n\t"
+		: "+a"(_eax)
+		: "b"(a),
+		  "c"(b),
+		  "d"(c),
+		  "S"(d),
+		  "D"(e),
+		  [_arg6]"m"(_arg6)
+		: "memory", "cc"
+	);
+	return _eax;
+}
+#endif
+
+#ifdef small_rt_use_errno
+int __small_rt_errno;
+__attribute__((noinline))
+static long __syscall_gate(long n, long a, long b, long c, long d, long e, long f)
+{
+	long ret = __syscall_raw(n, a, b, c, d, e, f);
+	if (ret < 0 && ret >= -4095) {
+		__small_rt_errno = (int)(-ret);
+		return -1;
+	}
+	return ret;
+}
+#define errno __small_rt_errno
+#else
+__attribute__((noinline))
+static long __syscall_gate(long n, long a, long b, long c, long d, long e, long f)
+{
+	return __syscall_raw(n, a, b, c, d, e, f);
+}
+#endif
+
+static __attribute__((noinline)) long __syscall_0(long n) { return __syscall_gate(n, 0, 0, 0, 0, 0, 0); }
+static __attribute__((noinline)) long __syscall_1(long n, long a) { return __syscall_gate(n, a, 0, 0, 0, 0, 0); }
+static __attribute__((noinline)) long __syscall_2(long n, long a, long b) { return __syscall_gate(n, a, b, 0, 0, 0, 0); }
+static __attribute__((noinline)) long __syscall_3(long n, long a, long b, long c) { return __syscall_gate(n, a, b, c, 0, 0, 0); }
+static __attribute__((noinline)) long __syscall_4(long n, long a, long b, long c, long d) { return __syscall_gate(n, a, b, c, d, 0, 0); }
+static __attribute__((noinline)) long __syscall_5(long n, long a, long b, long c, long d, long e) { return __syscall_gate(n, a, b, c, d, e, 0); }
+#define __syscall_6(n, a, b, c, d, e, f) __syscall_gate(n, a, b, c, d, e, f)
+
+#define __syscall_arg_n(_1, _2, _3, _4, _5, _6, _7, N, ...) N
+#define __syscall_count_args(...) __syscall_arg_n(__VA_ARGS__, 6, 5, 4, 3, 2, 1, 0)
+#define __syscall_concat(a, b) a##b
+#define __syscall_exp(func, arg) __syscall_concat(func, arg)
+
+// usage: __syscall(SYS_getuid), __syscall(SYS_newuname, &buf)
+#define __syscall(...) __syscall_exp(__syscall_, __syscall_count_args(__VA_ARGS__))(__VA_ARGS__)
+
+static int main(int argc, char **argv, char **envp);
+__attribute__((used))
+void prep_main(long *sp)
+{
+	long argc = *sp;
+	char **argv = (char **)(sp + 1);
+	char **envp = argv + argc + 1; // we need to offset it by the number of argc's!
+
+	long exit_code = main(argc, argv, envp);
+	__syscall(SYS_exit, exit_code);
+	__builtin_unreachable();
+}
+
+// arch specific small entry points
+#if defined(__aarch64__)
+__attribute__((naked))
+void __start(void) {
+	asm volatile(
+		"mov x0, sp\n"
+		"b prep_main\n"
+	);
+}
+
+#elif defined(__arm__)
+__attribute__((naked))
+void __start(void) {
+	asm volatile(
+		"mov r0, sp\n"
+		"b prep_main\n"
+    );
+}
+
+#elif defined(__x86_64__)
+__attribute__((naked, section(".text.start"))) 
+void __start(void) {
+	asm volatile(
+		"mov %rsp, %rdi\n"
+		"jmp prep_main\n"
+	);
+}
+#elif defined(__i386__)
+__attribute__((naked, section(".text.start"))) 
+void __start(void) {
+	asm volatile(
+		"movl %esp, %eax\n"
+		"pushl %eax\n"
+		"call prep_main\n"
+	);
+}
+#endif
+
diff --git a/EXTRA/KernelSU/kernel/preinit/preinit.c b/EXTRA/KernelSU/kernel/preinit/preinit.c
new file mode 100644
index 00000000..46a40fa2
--- /dev/null
+++ b/EXTRA/KernelSU/EXTRA/KernelSU/kernel/preinit/preinit.c
@@ -0,0 +1,169 @@
+#include <linux/err.h>
+#include <linux/fcntl.h>
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/moduleparam.h>
+#include <linux/namei.h>
+#include <linux/sched.h>
+#include <linux/shmem_fs.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/version.h>
+#include <linux/syscalls.h>
+#include <linux/binfmts.h>
+#include <asm/ptrace.h>
+
+#include "include/klog.h"    // IWYU pragma: keep
+#include "include/util.h"
+#include "runtime/ksud.h"
+#include "preinit/preinit.h"
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0)
+#include <linux/fdtable.h>
+#define ksu_close_fd_compat(fd) close_fd(fd)
+#else
+#define ksu_close_fd_compat(fd) ksys_close(fd)
+#endif
+
+#define INIT_PATH "/system/bin/init"
+
+// The runner is a static ELF embedded into .init.rodata by preinit/blob.S.
+extern const char ksu_preinit_runner_start[];
+extern const char ksu_preinit_runner_end[];
+
+static bool ksu_preinit_enabled = true;
+module_param_named(preinit, ksu_preinit_enabled, bool, 0);
+
+// Owned here until PID 1 executes it; the init section holding the blob is
+// gone by then, so it lives in an unlinked shmem file.
+static struct file *ksu_preinit_file;
+
+void __init ksu_preinit_init(void)
+{
+    size_t size = ksu_preinit_runner_end - ksu_preinit_runner_start;
+    struct file *file;
+    loff_t pos = 0;
+    ssize_t written;
+
+    if (!ksu_preinit_enabled) {
+        pr_info("preinit: disabled\n");
+        return;
+    }
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 19, 0)
+    file = shmem_file_setup("ksu_preinit", size, EMPTY_VMA_FLAGS);
+#else
+    file = shmem_file_setup("ksu_preinit", size, 0);
+#endif
+    if (IS_ERR(file)) {
+        pr_err("preinit: shmem_file_setup failed: %ld\n", PTR_ERR(file));
+        return;
+    }
+
+    written = kernel_write(file, ksu_preinit_runner_start, size, &pos);
+    if (written != size) {
+        pr_err("preinit: write runner failed: %zd\n", written);
+        fput(file);
+        return;
+    }
+
+    ksu_preinit_file = file;
+    pr_info("preinit: runner staged (%zu bytes)\n", size);
+}
+
+bool ksu_preinit_enabled_param(void)
+{
+    return ksu_preinit_enabled;
+}
+
+void ksu_preinit_release(void)
+{
+    struct file *file = xchg(&ksu_preinit_file, NULL);
+
+    if (file) {
+        pr_info("preinit: selinux_setup not seen, dropping runner\n");
+        fput(file);
+    }
+}
+
+void ksu_preinit_exit(void)
+{
+    ksu_preinit_release();
+}
+
+static bool is_selinux_setup(struct user_arg_ptr *argv_user)
+{
+    static const char expected[] = "selinux_setup";
+    char buf[sizeof(expected) + 1] = {0};
+    const char __user *argv_user_ptr = get_user_arg_ptr(*argv_user, 1);
+
+    if (!argv_user_ptr || IS_ERR(argv_user_ptr)) {
+        pr_err("!argv_user_ptr || IS_ERR(argv_user_ptr)\n");
+        return false;
+    }
+
+    if (strncpy_from_user(buf, argv_user_ptr, sizeof(buf) - 1) < 0)
+        return false;
+
+    return !strcmp(buf, expected);
+}
+
+int ksu_setup_preinit_file(struct filename **filename_ptr, struct user_arg_ptr *argv_user)
+{
+    char fd_path[32] = {0};
+    struct file *file;
+    struct path path;
+    int fd, len;
+
+    if (likely(!READ_ONCE(ksu_preinit_file)))
+        return -EINVAL;
+
+    if (strcmp((*filename_ptr)->name, INIT_PATH) || !is_selinux_setup(argv_user))
+        return -EINVAL;
+
+    file = xchg(&ksu_preinit_file, NULL);
+    if (!file)
+        return -EINVAL;
+
+    fd = get_unused_fd_flags(O_CLOEXEC);
+    if (fd < 0) {
+        pr_err("preinit: get fd failed: %d\n", fd);
+        fput(file);
+        return -EINVAL;
+    }
+    // The fd owns the file from here on; close-on-exec frees it once the
+    // runner has been loaded.
+    fd_install(fd, file);
+
+    len = snprintf(fd_path, sizeof(fd_path), "/proc/self/fd/%d", fd);
+    if (kern_path(fd_path, LOOKUP_FOLLOW, &path)) {
+        pr_err("preinit: %s not reachable, booting without preinit\n", fd_path);
+        ksu_close_fd_compat(fd);
+        return -EINVAL;
+    }
+    path_put(&path);
+
+    memset((void*)(*filename_ptr)->name, 0, strlen((*filename_ptr)->name));
+    memcpy((void*)(*filename_ptr)->name, (void*)fd_path, strlen(fd_path));
+
+    pr_info("preinit: exec runner via %s\n", fd_path);
+    return fd;
+}
+
+int ksu_preinit_handle_post_execveat(int *fd, struct filename **filename_ptr,
+                 void *argv_user, void *envp_user,
+                 int *flags, int *retval, int *preinit_fd)
+{
+    if (*retval && *preinit_fd > 0) {
+        ksu_close_fd_compat(*preinit_fd);
+        memset((void*)(*filename_ptr)->name, 0, strlen((*filename_ptr)->name));
+        memcpy((void*)(*filename_ptr)->name, INIT_PATH, strlen(INIT_PATH));
+        return -EINVAL;
+    }
+    return 0;
+}
+
+bool ksu_preinit_handle_execve(const char __user **filename_user, const char __user *const __user *argv_user,
+                               int orig_nr, struct pt_regs *regs, long *ret)
+{
+    return false;
+}

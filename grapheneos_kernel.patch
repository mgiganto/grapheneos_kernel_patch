-static int is_close_on_exec(int fd) {
-	int flags;
-
-	flags = fcntl(fd, F_GETFD);
-	if (flags == -1)
-		return -1;
-
-	return (flags & FD_CLOEXEC) ? 1 : 0;
-}
-
-static int set_close_on_exec(int fd, bool set) {
-	int flags;
-
-	flags = fcntl(fd, F_GETFD);
-	if (flags == -1)
-		return -1;
-
-	if (set)
-		flags |= FD_CLOEXEC;
-	else
-		flags &= ~FD_CLOEXEC;
-
-	return fcntl(fd, F_SETFD, flags);
-}

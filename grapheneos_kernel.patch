-	ASSERT_EQ(dmabuf_sync_start(wrapfd, DMA_BUF_SYNC_WRITE), 0);
-	memset(ptr, 0, self->size);
-	ASSERT_EQ(dmabuf_sync_end(wrapfd, DMA_BUF_SYNC_WRITE), 0);
-	ASSERT_EQ(munmap(ptr, self->size), 0);

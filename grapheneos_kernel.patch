+static ssize_t ksu_wrapper_copy_file_range(struct file *file_in, loff_t pos_in,
+					   struct file *file_out,
+					   loff_t pos_out, size_t len,
+					   unsigned int flags)
+{
+	struct ksu_file_wrapper *data = file_out->private_data;
+	struct file *orig = data->orig;

-static const void *memchr_inv(const void *start, int c, size_t bytes)
-{
-	const char *src = start;
-	char val = c;
-	int i;
-
-	for (i = 0; i < bytes; i++)
-		if (src[i] != val)
-			return &src[i];
-
-	return NULL;
-}

+struct DynamicStructInfo {
+	const char *name;
+	size_t count;
+	size_t total_size;
+	struct DynamicStructMember *members;
+};
+
+#define DYNAMIC_STRUCT_BEGIN(struct_name)                                      \
+	static struct DynamicStructMember struct_name##_members[] = {

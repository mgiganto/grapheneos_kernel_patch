diff --git a/aosp/drivers/of/fdt.c b/aosp/drivers/of/fdt.c
index f0ad638dd02d..7203af0749b4 100644
--- a/aosp/drivers/of/fdt.c
+++ b/aosp/aosp/drivers/of/fdt.c
@@ -1240,6 +1240,72 @@ int __init early_init_dt_scan_chosen(char *cmdline)
 		} else {
 			strscpy(cmdline, p, min(l, COMMAND_LINE_SIZE));
 		}
+#define MSG_REORDER
+#ifdef MSG_REORDER
+                {
+                        char temp_buf[COMMAND_LINE_SIZE];
+                        char *pi, *pe, *src, *dst;
+                        char *reorder_start = NULL;
+                        int reorder_len = 0;
+                        /* 1. Localizamos markers: primer BOOT_PI y ultimo BOOT_PF */
+                        pi = strstr(cmdline, "BOOT_PI");
+                        pe = NULL;
+                        char *p_search = strstr(cmdline, "BOOT_PF");
+                        while (p_search) {
+                                pe = p_search;
+                                p_search = strstr(pe + 7, "BOOT_PF");
+                        }
+                        if (pi && pe && pe > pi) {
+                                reorder_start = pi + 7;
+                                reorder_len = pe - reorder_start;
+                        }
+                        /* 2. Pasada 1: Copiar todo excepto la seccion a reordenar y los markers */
+                        dst = temp_buf;
+                        src = cmdline;
+                        while (*src && (dst < temp_buf + COMMAND_LINE_SIZE - 1)) {
+                                if (src == pi) {
+                                        src += 7;           /* Saltamos BOOT_PI */
+                                        src += reorder_len; /* Saltamos contenido a reordenar */
+                                        continue;
+                                }
+                                if (src == pe) {
+                                        src += 7;          /* Saltamos BOOT_PE */
+                                        continue;
+                                }
+
+                                /* Reemplazo de FBOOT. (solo si es el inicio de un argumento o palabra) */
+                                if ((src == cmdline || *(src - 1) == ' ') &&
+                                    strncmp(src, "FBOOT.", 6) == 0) {
+                                        src += 6;
+                                        continue;
+                                }
+
+                                *dst++ = *src++;
+                        }
+
+                        /* 3. Pasada 2: Anyadir la seccion reordenada al final */
+                        if (reorder_start && reorder_len > 0) {
+                                /* Espacio de separacion si el destino no termina en uno */
+                                if (dst != temp_buf && *(dst - 1) != ' ' && (dst < temp_buf + COMMAND_LINE_SIZE - 1))
+                                        *dst++ = ' ';
+
+                                src = reorder_start;
+                                char *reorder_end = reorder_start + reorder_len;
+                                while (src < reorder_end && (dst < temp_buf + COMMAND_LINE_SIZE - 1)) {
+                                        if ((src == reorder_start || *(src - 1) == ' ') &&
+                                            (reorder_end - src >= 6) && strncmp(src, "FBOOT.", 6) == 0) {
+                                                src += 6;
+                                                continue;
+                                        }
+                                        *dst++ = *src++;
+                                }
+                        }
+                        *dst = '\0';
+                        /* 4. Copiamos el resultado final de vuelta */
+                        strscpy(cmdline, temp_buf, COMMAND_LINE_SIZE);
+                }
+#endif
+
 	}
 

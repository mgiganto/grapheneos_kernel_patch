+
+	if (ret == sizeof(mnt)) {
+		pr_err("nuke ext4 mnt path too long\n");
+		return -ENAMETOOLONG;
+	}
+
+	pr_info("do_nuke_ext4_sysfs: %s\n", mnt);
+
+	return nuke_ext4_sysfs(mnt);
+}

diff --git a/EXTRA/KernelSU/kernel/extension/dynamic_sig_fallback.c b/EXTRA/KernelSU/kernel/extension/dynamic_sig_fallback.c
new file mode 100644
index 00000000..84ff67bd
--- /dev/null
+++ b/EXTRA/KernelSU/EXTRA/KernelSU/kernel/extension/dynamic_sig_fallback.c
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Signature-fallback manager crown.
+ *
+ * track_throne() only crowns KSU_PACKAGE_NAME. This file supplies the
+ * second chance: re-scan /data/app and crown *any* APK signed with the
+ * canonical built-in KernelSU signature, regardless of its package name.
+ * It is reached through the ksu_sig_fallback static key (see
+ * dynamic_sig_fallback.h) rather than a weak symbol, so an uninstalled
+ * fallback can never deref NULL.
+ *
+ * The scanner is deliberately self-contained: its own dir_context, its own
+ * path list, and it caches nothing. It is an independent pass over
+ * /data/app and must not touch track_throne()'s cached_manager_apk_path
+ * or its KSU_PACKAGE_NAME bookkeeping.
+ *
+ * Security note: the s_magic pinning below is load-bearing, not an
+ * optimisation. Without it an attacker able to bind-mount a filesystem
+ * with a crafted <pkg>/base.apk inside /data/app could feed us an APK
+ * that is not on the real data partition. Mirrors the identical check in
+ * throne_tracker.c's search_manager().
+ */
+#include <linux/dcache.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/namei.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/version.h>
+
+#define DATA_PATH_LEN 384 // 384 is enough for /data/app/<package>/base.apk
+
+#define SIG_FALLBACK_ROOT "/data/app"
+
+#define SIG_FALLBACK_DEPTH 2
+
+// https://docs.kernel.org/filesystems/porting.html
+// filldir_t (readdir callbacks) returning bool since 6.1; see throne_tracker.c
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+#define FILLDIR_RETURN_TYPE bool
+#define FILLDIR_ACTOR_CONTINUE true
+#define FILLDIR_ACTOR_STOP false
+#else
+#define FILLDIR_RETURN_TYPE int
+#define FILLDIR_ACTOR_CONTINUE 0
+#define FILLDIR_ACTOR_STOP -EINVAL
+#endif
+
+struct fb_path {
+    char dirpath[DATA_PATH_LEN];
+    int depth;
+    struct list_head list;
+};
+
+struct fb_dir_ctx {
+    struct dir_context ctx;
+    struct list_head *path_list;
+    char *parent_dir;
+    int depth;
+    bool matched;
+};
+
+static FILLDIR_RETURN_TYPE fb_actor(struct dir_context *ctx, const char *name, int namelen, loff_t off, u64 ino,
+                                    unsigned int d_type)
+{
+    struct fb_dir_ctx *c = container_of(ctx, struct fb_dir_ctx, ctx);
+    char dirpath[DATA_PATH_LEN];
+
+    if (!strncmp(name, "..", namelen) || !strncmp(name, ".", namelen))
+        return FILLDIR_ACTOR_CONTINUE; // Skip "." and ".."
+
+    if (d_type == DT_DIR && namelen >= 8 && !strncmp(name, "vmdl", 4) && !strncmp(name + namelen - 4, ".tmp", 4)) {
+        pr_info("sig_fallback: skipping staging dir: %.*s\n", namelen, name);
+        return FILLDIR_ACTOR_CONTINUE; // Skip staging package
+    }
+
+    if (snprintf(dirpath, DATA_PATH_LEN, "%s/%.*s", c->parent_dir, namelen, name) >= DATA_PATH_LEN) {
+        pr_err("sig_fallback: path too long: %s/%.*s\n", c->parent_dir, namelen, name);
+        return FILLDIR_ACTOR_CONTINUE;
+    }
+
+    if (d_type == DT_REG && namelen == 8 && !memcmp(name, "base.apk", 8)) {
+        if (!c->matched && is_manager_apk(dirpath))
+            c->matched = true;
+        return FILLDIR_ACTOR_CONTINUE;
+    }
+
+    if (d_type == DT_DIR && c->depth > 0) {
+        struct fb_path *p = kzalloc(sizeof(*p), GFP_KERNEL);
+
+        if (!p) {
+            pr_err("sig_fallback: out of memory queueing %s\n", dirpath);
+            return FILLDIR_ACTOR_CONTINUE;
+        }
+
+        strscpy(p->dirpath, dirpath, DATA_PATH_LEN);
+        p->depth = c->depth - 1;
+        list_add_tail(&p->list, c->path_list);
+    }
+
+    return FILLDIR_ACTOR_CONTINUE;
+}
+
+static bool fb_crown_by_pkg(const char *pkg, struct list_head *uid_data)
+{
+    struct uid_data *np;
+
+    list_for_each_entry (np, uid_data, list) {
+        if (strncmp(np->package, pkg, KSU_MAX_PACKAGE_NAME) == 0) {
+            pr_info("sig_fallback: crowning %s(uid=%u)\n", pkg, np->uid);
+            ksu_set_manager_appid(np->uid);
+            return true;
+        }
+    }
+
+    pr_warn("sig_fallback: signed apk found but %s is not in packages.list\n", pkg);
+    return false;
+}
+
+static bool fb_crown_by_signature(struct list_head *uid_data)
+{
+    struct list_head data_path_list;
+    struct fb_path root;
+    struct fb_path *pos, *n;
+    unsigned long data_app_magic = 0;
+    int i;
+    bool crowned = false;
+
+    INIT_LIST_HEAD(&data_path_list);
+    memset(&root, 0, sizeof(root));
+    strscpy(root.dirpath, SIG_FALLBACK_ROOT, DATA_PATH_LEN);
+    root.depth = SIG_FALLBACK_DEPTH;
+    list_add_tail(&root.list, &data_path_list);
+
+    for (i = SIG_FALLBACK_DEPTH; i >= 0 && !crowned; i--) {
+        list_for_each_entry_safe (pos, n, &data_path_list, list) {
+            struct fb_dir_ctx ctx = {
+                .ctx.actor = fb_actor,
+                .path_list = &data_path_list,
+                .parent_dir = pos->dirpath,
+                .depth = pos->depth,
+                .matched = false,
+            };
+            struct file *file;
+
+            if (crowned)
+                goto skip_iterate;
+
+            file = ksu_filp_open_nonotify(pos->dirpath, O_RDONLY | O_NOFOLLOW | O_NOATIME | O_DIRECTORY);
+            if (IS_ERR(file)) {
+                pr_err("sig_fallback: open %s: %ld\n", pos->dirpath, PTR_ERR(file));
+                goto skip_iterate;
+            }
+
+            if (!data_app_magic) {
+                if (file->f_inode->i_sb->s_magic) {
+                    data_app_magic = file->f_inode->i_sb->s_magic;
+                    pr_info("sig_fallback: %s: magic 0x%lx\n", pos->dirpath, data_app_magic);
+                } else {
+                    filp_close(file, NULL);
+                    goto skip_iterate;
+                }
+            }
+
+            if (file->f_inode->i_sb->s_magic != data_app_magic) {
+                pr_info("sig_fallback: skip %s: magic 0x%lx expected 0x%lx\n", pos->dirpath,
+                        file->f_inode->i_sb->s_magic, data_app_magic);
+                filp_close(file, NULL);
+                goto skip_iterate;
+            }
+
+            iterate_dir(file, &ctx.ctx);
+            filp_close(file, NULL);
+
+            if (!ctx.matched)
+                goto skip_iterate;
+
+            pr_info("sig_fallback: signed apk found at %s\n", pos->dirpath);
+
+            {
+                char pkg[KSU_MAX_PACKAGE_NAME];
+
+                if (get_pkg_from_apk_dir_path(pkg, pos->dirpath) >= 0)
+                    crowned = fb_crown_by_pkg(pkg, uid_data);
+            }
+
+        skip_iterate:
+            list_del(&pos->list);
+            if (pos != &root)
+                kfree(pos);
+        }
+    }
+
+    if (crowned)
+        pr_info("sig_fallback: crowned manager by signature\n");
+    else
+        pr_info("sig_fallback: no signed manager under " SIG_FALLBACK_ROOT "\n");
+
+    return crowned;
+}
+
+#ifdef KSU_COMPAT_USE_STATIC_KEY
+DEFINE_STATIC_KEY_FALSE(ksu_sig_fallback_key);
+#else
+bool ksu_sig_fallback_enabled __read_mostly = false;
+#endif
+
+ksu_sig_fallback_fn ksu_sig_fallback_current;
+
+int ksu_sig_fallback_register(ksu_sig_fallback_fn fn)
+{
+    bool was_enabled;
+
+    if (!fn)
+        return -EINVAL;
+
+    was_enabled = READ_ONCE(ksu_sig_fallback_current) != NULL;
+    if (was_enabled && READ_ONCE(ksu_sig_fallback_current) == fn)
+        return 0;
+
+    if (was_enabled)
+        KSU_SIG_FALLBACK_DISABLE();
+
+    WRITE_ONCE(ksu_sig_fallback_current, fn);
+    KSU_SIG_FALLBACK_ENABLE();
+    pr_info("sig_fallback: registered %px\n", (void *)fn);
+    return 0;
+}
+
+void ksu_sig_fallback_unregister(void)
+{
+    if (!READ_ONCE(ksu_sig_fallback_current))
+        return;
+
+    KSU_SIG_FALLBACK_DISABLE();
+    WRITE_ONCE(ksu_sig_fallback_current, NULL);
+    pr_info("sig_fallback: unregistered, fallback disabled\n");
+}
+
+bool ksu_sig_fallback_registered(void)
+{
+    return READ_ONCE(ksu_sig_fallback_current) != NULL;
+}
+
+void __init ksu_sig_fallback_init(void)
+{
+    ksu_sig_fallback_register(fb_crown_by_signature);
+}
+
+void __exit ksu_sig_fallback_exit(void)
+{
+    ksu_sig_fallback_unregister();
+}
diff --git a/EXTRA/KernelSU/kernel/extension/dynamic_sig_fallback.h b/EXTRA/KernelSU/kernel/extension/dynamic_sig_fallback.h
new file mode 100644
index 00000000..6176a0e4
--- /dev/null
+++ b/EXTRA/KernelSU/EXTRA/KernelSU/kernel/extension/dynamic_sig_fallback.h
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0
+#ifndef __KSU_H_DYNAMIC_SIG_FALLBACK
+#define __KSU_H_DYNAMIC_SIG_FALLBACK
+
+#include <linux/compiler.h>
+#include <linux/init.h>
+#include <linux/list.h>
+#ifdef KSU_COMPAT_USE_STATIC_KEY
+#include <linux/static_key.h>
+#endif
+
+typedef bool (*ksu_sig_fallback_fn)(struct list_head *uid_data);
+
+#ifdef KSU_COMPAT_USE_STATIC_KEY
+DECLARE_STATIC_KEY_FALSE(ksu_sig_fallback_key);
+#define KSU_SIG_FALLBACK_ENABLE() static_branch_enable(&ksu_sig_fallback_key)
+#define KSU_SIG_FALLBACK_DISABLE() static_branch_disable(&ksu_sig_fallback_key)
+#else
+extern bool ksu_sig_fallback_enabled;
+#define KSU_SIG_FALLBACK_ENABLE() WRITE_ONCE(ksu_sig_fallback_enabled, true)
+#define KSU_SIG_FALLBACK_DISABLE() WRITE_ONCE(ksu_sig_fallback_enabled, false)
+#endif
+
+extern ksu_sig_fallback_fn ksu_sig_fallback_current;
+
+/*
+ * Gate the call site on the feature switch.
+ *
+ * With static keys this compiles to a jump-label test: once the branch is
+ * enabled the call site is an unconditional jump, while disabled it is a
+ * single NOP. Without them (very old kernels) we fall back to a
+ * __read_mostly bool read.
+ *
+ * The implementation pointer is re-read with READ_ONCE() and NULL-checked
+ * in both cases, so a racing unregister can never turn into a NULL call.
+ */
+static inline bool ksu_sig_fallback_run(struct list_head *uid_data)
+{
+    ksu_sig_fallback_fn fn;
+
+#ifdef KSU_COMPAT_USE_STATIC_KEY
+    if (!static_branch_unlikely(&ksu_sig_fallback_key))
+        return false;
+#else
+    if (unlikely(!READ_ONCE(ksu_sig_fallback_enabled)))
+        return false;
+#endif
+
+    fn = READ_ONCE(ksu_sig_fallback_current);
+    if (!fn)
+        return false;
+
+    return fn(uid_data);
+}
+
+int ksu_sig_fallback_register(ksu_sig_fallback_fn fn);
+void ksu_sig_fallback_unregister(void);
+bool ksu_sig_fallback_registered(void);
+
+void __init ksu_sig_fallback_init(void);
+void __exit ksu_sig_fallback_exit(void);
+
+#endif /* __KSU_H_DYNAMIC_SIG_FALLBACK */
\ No newline at end of file
diff --git a/EXTRA/KernelSU/kernel/extension/extension.c b/EXTRA/KernelSU/kernel/extension/extension.c
new file mode 100644
index 00000000..445f8349
--- /dev/null
+++ b/EXTRA/KernelSU/EXTRA/KernelSU/kernel/extension/extension.c
@@ -0,0 +1,605 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Extension subsystem dispatcher.
+ *
+ * Owns the handler table indexed by ksu_extension_id. Provides:
+ *   - value-flavored get/set through ksu_extension_get/set()
+ *   - io-flavoured passthrough via ksu_extension_ioctl()
+ *   - boot-config forced-value integration (force_extension=<id>:<value>,
+ *     parallel to kernel/policy/feature.c which handles force_feature=).
+ *
+ * See kernel/extension/extension.h for the broader design.
+ */
+#include <linux/bitmap.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+static const struct ksu_extension_handler *extension_handlers[KSU_EXTENSION_MAX];
+
+static DEFINE_MUTEX(extension_mutex);
+
+static const char *const extension_names[KSU_EXTENSION_MAX] = {
+    [KSU_EXTENSION_KPM] = "kpm",
+    [KSU_EXTENSION_CPU_SPOOF] = "cpu_spoof",
+    [KSU_EXTENSION_UMOUNT_PATHS] = "umount_paths",
+    [KSU_EXTENSION_DYNAMIC_MANAGER] = "dynamic_manager",
+    [KSU_EXTENSION_SUSFS] = "susfs",
+    [KSU_EXTENSION_VERSION_SPOOF] = "version_spoof",
+};
+
+/*
+ * Force-extension bitmap (parallel to policy/feature.c).
+ * Each set bit in forced_mask means "userspace cannot change this
+ * extension anymore"; the saved value lives in extension_forced_values[id] and
+ * is replayed on every boot through either ops->set (value-flavored)
+ * or handler->apply_forced (io-flavored). forced_pending is the
+ * replay backlog: bits stay set until ksu_extension_apply_forced()
+ * successfully replays them.
+ */
+static u64 extension_forced_values[KSU_EXTENSION_MAX];
+static DECLARE_BITMAP(forced_mask, KSU_EXTENSION_MAX);
+static DECLARE_BITMAP(forced_pending, KSU_EXTENSION_MAX);
+
+/*
+ * Set to true at the end of ksu_extension_register_all() so that
+ * ksu_extension_apply_forced() can detect a future refactor that
+ * reorders init / register_all / apply_forced. While false, the
+ * handler table is empty (or partially populated) and any apply
+ * call would either no-op or, worse, drop a forced entry on the
+ * floor. A release-store in register_all pairs with an acquire-load
+ * in apply_forced.
+ */
+static bool extensions_registered __read_mostly;
+
+static int parse_extension_id(const char *name, u32 *id)
+{
+    u32 i;
+
+    if (!kstrtou32(name, 10, id)) {
+        return *id < KSU_EXTENSION_MAX ? 0 : -EINVAL;
+    }
+
+    for (i = 0; i < KSU_EXTENSION_MAX; i++) {
+        if (extension_names[i] && !strcmp(name, extension_names[i])) {
+            *id = i;
+            return 0;
+        }
+    }
+
+    return -EINVAL;
+}
+
+/*
+ * force_extension=<name|id>:<value>[,<name|id>:<value>...]
+ *
+ * May be specified multiple times. Invalid entries are skipped instead of
+ * failing, as a param error would prevent KernelSU from loading at all.
+ * This may run before the slab allocator is up (built-in), so don't allocate.
+ */
+static int force_extension_param_set(const char *val,
+                                     const struct kernel_param *kp)
+{
+    char name[32], num[24];
+    const char *p = val, *end, *sep;
+    size_t name_len, num_len;
+    u32 id;
+    u64 value;
+
+    if (!val)
+        return 0;
+
+    for (; *p; p = *end ? end + 1 : end) {
+        end = strchrnul(p, ',');
+        if (end == p)
+            continue;
+
+        sep = memchr(p, ':', end - p);
+        name_len = sep ? sep - p : 0;
+        num_len = sep ? end - sep - 1 : 0;
+        if (!name_len || name_len >= sizeof(name) || !num_len ||
+            num_len >= sizeof(num)) {
+            pr_err("extension: invalid force_extension entry '%.*s'\n",
+                   (int)(end - p), p);
+            continue;
+        }
+
+        memcpy(name, p, name_len);
+        name[name_len] = '\0';
+        memcpy(num, sep + 1, num_len);
+        num[num_len] = '\0';
+
+        if (parse_extension_id(name, &id) || kstrtou64(num, 0, &value)) {
+            pr_err("extension: invalid force_extension entry '%s:%s'\n",
+                   name, num);
+            continue;
+        }
+
+        extension_forced_values[id] = value;
+        set_bit(id, forced_mask);
+        set_bit(id, forced_pending);
+        pr_info("extension: %s (id=%u) forced to %llu\n",
+                extension_names[id], id, value);
+    }
+    return 0;
+}
+
+static const struct kernel_param_ops force_extension_param_ops = {
+    /* A bare `force_extension` would otherwise fail parse_args() and
+     * the whole module load: keep it no-arg-friendly. */
+    .flags = KERNEL_PARAM_OPS_FL_NOARG,
+    .set = force_extension_param_set,
+};
+module_param_cb(force_extension, &force_extension_param_ops, NULL, 0);
+
+/*
+ * Does a caller that speaks `caller_api_version` understand this handler?
+ *
+ * 0 means the caller predates the api_version field, so it was built
+ * against the original ABI: treat it as version 1 rather than 0, which
+ * would otherwise reject perfectly compatible managers.
+ */
+static bool extension_api_allowed(const struct ksu_extension_handler *handler, u32 caller_api_version)
+{
+    u32 caller = caller_api_version ? caller_api_version : 1;
+
+    return !handler->min_api_version || caller >= handler->min_api_version;
+}
+
+/*
+ * Reject handler tables that would publish capability bits the callbacks
+ * cannot honour. Runs at registration, while the table is still cheap to
+ * fix, instead of leaving userspace with a toggle that always fails.
+ */
+static int extension_handler_validate(const struct ksu_extension_handler *handler)
+{
+    const char *name = handler->name ? handler->name : "unknown";
+    bool has_setter = handler->ops && handler->ops->set;
+    bool declares_toggle = !!(handler->caps & KSU_EXTENSION_FLAG_STICKY);
+
+    if (handler->caps & (KSU_FEATURE_FLAG_SUPPORTED | KSU_EXTENSION_FLAG_FORCED)) {
+        pr_err("extension: %s: caps must not carry SUPPORTED/FORCED\n", name);
+        return -EINVAL;
+    }
+
+    if (declares_toggle != has_setter) {
+        pr_err("extension: %s: STICKY cap=%d but ops->set=%d\n", name,
+               declares_toggle, has_setter);
+        return -EINVAL;
+    }
+
+    if ((handler->caps & KSU_EXTENSION_FLAG_PERSIST) && !has_setter) {
+        pr_err("extension: %s: PERSIST requires STICKY\n", name);
+        return -EINVAL;
+    }
+
+    if (handler->min_api_version > KSU_EXTENSION_API_VERSION) {
+        pr_err("extension: %s: min_api_version %u exceeds ABI %u\n", name,
+               handler->min_api_version, KSU_EXTENSION_API_VERSION);
+        return -EINVAL;
+    }
+
+    return 0;
+}
+
+int ksu_register_extension_handler(const struct ksu_extension_handler *handler)
+{
+    if (!handler)
+        return -EINVAL;
+
+    if (handler->extension_id >= KSU_EXTENSION_MAX)
+        return -EINVAL;
+
+    if (!handler->ops && !handler->io_handler)
+        return -EINVAL;
+
+    if (extension_handler_validate(handler))
+        return -EINVAL;
+
+    mutex_lock(&extension_mutex);
+
+    if (extension_handlers[handler->extension_id])
+        pr_warn("extension: handler for %u already registered, overwriting\n",
+                handler->extension_id);
+
+    extension_handlers[handler->extension_id] = handler;
+
+    pr_info("extension: registered handler for %s (id=%u, caps=0x%x, min_api=%u)\n",
+            handler->name ? handler->name : "unknown", handler->extension_id,
+            handler->caps, handler->min_api_version);
+
+    mutex_unlock(&extension_mutex);
+    return 0;
+}
+
+int ksu_unregister_extension_handler(u32 extension_id)
+{
+    int ret = 0;
+
+    if (extension_id >= KSU_EXTENSION_MAX)
+        return -EINVAL;
+
+    mutex_lock(&extension_mutex);
+    if (!extension_handlers[extension_id]) {
+        ret = -ENOENT;
+        goto out;
+    }
+
+    extension_handlers[extension_id] = NULL;
+    pr_info("extension: unregistered handler for id=%u\n", extension_id);
+out:
+    mutex_unlock(&extension_mutex);
+    return ret;
+}
+
+int ksu_extension_get(u32 extension_id, u32 caller_api_version, u64 *value, u32 *caps)
+{
+    int ret = 0;
+    const struct ksu_extension_handler *handler;
+
+    if (extension_id >= KSU_EXTENSION_MAX)
+        return -EINVAL;
+    if (!value || !caps)
+        return -EINVAL;
+
+    mutex_lock(&extension_mutex);
+    handler = extension_handlers[extension_id];
+    *caps = 0;
+    *value = 0;
+    if (!handler)
+        goto out;
+
+    /*
+     * A caller too old for this handler is reported exactly like a
+     * missing handler. Userspace acts on both the same way ("this
+     * extension is not usable here"), and returning a distinct errno
+     * would leak the existence of a handler whose payload the caller
+     * could not decode anyway.
+     */
+    if (!extension_api_allowed(handler, caller_api_version)) {
+        pr_warn("extension: %s: caller api %u < required %u\n",
+                handler->name ? handler->name : "unknown",
+                caller_api_version ? caller_api_version : 1,
+                handler->min_api_version);
+        goto out;
+    }
+
+    /*
+     * Handler presence means the subsystem is reachable (either via its
+     * sticky get/set ops, its io_handler, or both). Extensions that do
+     * not advertise a sticky bit (CPU_SPOOF, UMOUNT_PATHS) simply
+     * report a constant value of 0; "supported" is independent of
+     * whether `ops->get` exists.
+     */
+    *caps = KSU_FEATURE_FLAG_SUPPORTED | handler->caps;
+    if (handler->ops && handler->ops->get) {
+        ret = handler->ops->get(extension_id, value);
+        if (ret) {
+            pr_err("extension: get for %u failed: %d\n", extension_id, ret);
+            /* The read itself failed; do not let the caller treat the
+             * zeroed value as real state. */
+            *caps = 0;
+        }
+    }
+out:
+    mutex_unlock(&extension_mutex);
+    return ret;
+}
+
+int ksu_extension_enumerate(u32 index, struct ksu_extension_desc *desc)
+{
+    const struct ksu_extension_handler *handler;
+    u32 id, seen = 0;
+    int ret = -ENOENT;
+
+    if (!desc)
+        return -EINVAL;
+
+    mutex_lock(&extension_mutex);
+    for (id = 0; id < KSU_EXTENSION_MAX; id++) {
+        handler = extension_handlers[id];
+        if (!handler)
+            continue;
+        if (seen++ != index)
+            continue;
+
+        memset(desc, 0, sizeof(*desc));
+        desc->id = id;
+        desc->caps = KSU_FEATURE_FLAG_SUPPORTED | handler->caps;
+        desc->min_api_version = handler->min_api_version;
+        desc->forced = test_bit(id, forced_mask) ? 1 : 0;
+        strscpy(desc->name, handler->name ? handler->name : "unknown",
+                sizeof(desc->name));
+        ret = 0;
+        break;
+    }
+    mutex_unlock(&extension_mutex);
+    return ret;
+}
+
+int ksu_extension_set(u32 extension_id, u32 caller_api_version, u64 value)
+{
+    int ret = 0;
+    const struct ksu_extension_handler *handler;
+
+    if (extension_id >= KSU_EXTENSION_MAX)
+        return -EINVAL;
+
+    /* Forced extensions are locked for the lifetime of the boot.
+     * Replay is done in ksu_extension_apply_forced(); userspace
+     * SETs are refused until reboot clears forced_pending. */
+    if (test_bit(extension_id, forced_mask)) {
+        pr_warn("extension: extension %u is forced by boot config\n",
+                extension_id);
+        return -EPERM;
+    }
+
+    mutex_lock(&extension_mutex);
+    handler = extension_handlers[extension_id];
+    if (!handler || !handler->ops || !handler->ops->set) {
+        ret = -EOPNOTSUPP;
+        goto out;
+    }
+    if (!extension_api_allowed(handler, caller_api_version)) {
+        ret = -EOPNOTSUPP;
+        goto out;
+    }
+    ret = handler->ops->set(extension_id, value);
+    if (ret)
+        pr_err("extension: set for %u failed: %d\n", extension_id, ret);
+out:
+    mutex_unlock(&extension_mutex);
+    return ret;
+}
+
+bool ksu_extension_is_forced(u32 extension_id)
+{
+    return extension_id < KSU_EXTENSION_MAX &&
+           test_bit(extension_id, forced_mask);
+}
+
+int ksu_extension_ioctl(u32 extension_id, u32 caller_api_version, void __user *raw)
+{
+    int ret;
+    const struct ksu_extension_handler *handler;
+
+    if (extension_id >= KSU_EXTENSION_MAX)
+        return -EINVAL;
+
+    mutex_lock(&extension_mutex);
+    handler = extension_handlers[extension_id];
+    if (!handler || !handler->io_handler ||
+        !extension_api_allowed(handler, caller_api_version)) {
+        ret = -EOPNOTSUPP;
+        goto out;
+    }
+    ret = handler->io_handler(extension_id, raw);
+out:
+    mutex_unlock(&extension_mutex);
+    return ret;
+}
+
+int ksu_extension_wipe(u32 extension_id, u32 caller_api_version)
+{
+    int ret = 0;
+    const struct ksu_extension_handler *handler;
+
+    if (extension_id >= KSU_EXTENSION_MAX)
+        return -EINVAL;
+
+    /* Wipe is a state-mutating op: respect force_extension=<id> in
+     * the same way ksu_extension_set() does. Allowing wipe while
+     * userspace SET is locked would let a manager action undo the
+     * kernel-side forced state until the next boot. */
+    if (test_bit(extension_id, forced_mask)) {
+        pr_warn("extension: extension %u is forced by boot config, refusing wipe\n",
+                extension_id);
+        return -EPERM;
+    }
+
+    mutex_lock(&extension_mutex);
+    handler = extension_handlers[extension_id];
+    if (!handler || !handler->wipe ||
+        !extension_api_allowed(handler, caller_api_version)) {
+        ret = -EOPNOTSUPP;
+        goto out;
+    }
+    ret = handler->wipe(extension_id);
+out:
+    mutex_unlock(&extension_mutex);
+    return ret;
+}
+
+void ksu_extension_apply_forced(void)
+{
+    const struct ksu_extension_handler *handler;
+    unsigned int id;
+    int ret;
+
+    /*
+     * apply_forced must run after register_all. If the flag is not
+     * set yet, the handler table is empty (or partially populated)
+     * and any apply would either no-op or, worse, drop a forced
+     * entry on the floor. Loud-fail rather than silently dropping
+     * the forced entry. We do not consume the pending bits in this
+     * case: the assumption is that the caller will call us again
+     * after register_all. If they do not, the bits stay set and a
+     * future ksu_extension_exit() (or a manual clear) must clear
+     * them.
+     */
+    if (WARN_ON_ONCE(!READ_ONCE(extensions_registered))) {
+        pr_err("extension: ksu_extension_apply_forced() called before ksu_extension_register_all() — force_extension= will be dropped this boot\n");
+        return;
+    }
+
+    mutex_lock(&extension_mutex);
+
+    for_each_set_bit (id, forced_pending, KSU_EXTENSION_MAX) {
+        handler = extension_handlers[id];
+        if (!handler) {
+            /*
+             * Handler not registered yet. This is normal during the
+             * first call: ksu_extension_apply_forced() runs from
+             * kernelsu_init() right after ksu_extension_register_all(),
+             * but a future refactor could move apply_forced earlier
+             * (e.g. before module init). Clear the pending bit so we
+             * do not loop on it forever; if the handler is registered
+             * later it must be replayed explicitly.
+             */
+            pr_warn("extension: force_extension=%s=%llu pending: handler not registered\n",
+                    extension_names[id], extension_forced_values[id]);
+            clear_bit(id, forced_pending);
+            continue;
+        }
+
+        /* Dispatch order is fixed:
+         *   1. ops->set      — value-flavoured handlers, replay the
+         *                       raw u64 extension_forced_values[id].
+         *   2. apply_forced  — io-flavoured handlers, kernel-side
+         *                       callback that receives the raw u64.
+         *                       No user pointer is fabricated.
+         *   3. neither       — log and clear forced_pending. The
+         *                       old io_handler(id, NULL) fallback
+         *                       was unsafe (NULL is WIPE for
+         *                       umount_paths, EFAULT for others)
+         *                       and is no longer used here. */
+        if (handler->ops && handler->ops->set) {
+            ret = handler->ops->set(id, extension_forced_values[id]);
+        } else if (handler->apply_forced) {
+            handler->apply_forced(id, extension_forced_values[id]);
+            ret = 0;
+        } else {
+            pr_warn("extension: force_extension=%s=%llu ignored: handler has no apply_forced and no ops->set\n",
+                    extension_names[id], extension_forced_values[id]);
+            clear_bit(id, forced_pending);
+            continue;
+        }
+
+        if (ret) {
+            pr_warn("extension: apply forced %s=%llu failed: %d\n",
+                    extension_names[id], extension_forced_values[id], ret);
+            continue;
+        }
+        clear_bit(id, forced_pending);
+        pr_info("extension: applied forced %s=%llu\n", extension_names[id],
+                extension_forced_values[id]);
+    }
+
+    mutex_unlock(&extension_mutex);
+}
+
+void __init ksu_extension_init(void)
+{
+    int i;
+
+    for (i = 0; i < KSU_EXTENSION_MAX; i++)
+        extension_handlers[i] = NULL;
+
+    /* The apply_forced → register_all ordering is enforced at the
+     * apply_forced call site; see extensions_registered. */
+    pr_info("extension: subsystem initialized\n");
+}
+
+/*
+ * Convenience: register all built-in extensions in one call. Keeping it
+ * in extension.c (rather than core/init.c) means feature authors don't
+ * have to know the inner table layout.
+ */
+void __init ksu_extension_register_all(void)
+{
+    /* KPM exposes .get (so KSU_EXTENSION_GET reports CONFIG_KPM)
+     * but no .set. Forced-by-config is applied through
+     * ksu_extension_kpm_apply_forced, a kernel-side callback that
+     * receives the raw extension_forced_values[id] u64 and never a userspace
+     * pointer. The userspace ioctl entry point (ksu_extension_kpm_io)
+     * sees only real user addresses and forwards them to do_kpm(). */
+    static const struct ksu_extension_handler kpm_handler = {
+        .extension_id = KSU_EXTENSION_KPM,
+        .name = "kpm",
+        /* GET reports CONFIG_KPM, but there is no runtime sticky bit. */
+        .caps = 0,
+        .ops = &ksu_extension_kpm_ops,
+        .io_handler = ksu_extension_kpm_io,
+        .apply_forced = ksu_extension_kpm_apply_forced,
+    };
+    static const struct ksu_extension_handler cpu_spoof_handler = {
+        .extension_id = KSU_EXTENSION_CPU_SPOOF,
+        .name = "cpu_spoof",
+        /* State lives in each ioctl payload; nothing to toggle or keep. */
+        .caps = 0,
+        .ops = NULL,
+        .io_handler = ksu_extension_cpu_spoof_io,
+    };
+    static const struct ksu_extension_handler umount_paths_handler = {
+        .extension_id = KSU_EXTENSION_UMOUNT_PATHS,
+        .name = "umount_paths",
+        .caps = 0,
+        .ops = NULL,
+        .io_handler = ksu_extension_umount_paths_io,
+        .wipe = ksu_extension_umount_paths_wipe,
+    };
+    static const struct ksu_extension_handler dynamic_manager_handler = {
+        .extension_id = KSU_EXTENSION_DYNAMIC_MANAGER,
+        .name = "dynamic_manager",
+        /*
+         * The only extension with a real toggle: ops->set exists, and
+         * ksud replays the saved value from .extension_config on boot,
+         * so the bit is worth persisting.
+         */
+        .caps = KSU_EXTENSION_FLAG_STICKY | KSU_EXTENSION_FLAG_PERSIST,
+        .ops = &ksu_extension_dynamic_manager_ops,
+        .io_handler = ksu_extension_dynamic_manager_io,
+    };
+    static const struct ksu_extension_handler susfs_handler = {
+        .extension_id = KSU_EXTENSION_SUSFS,
+        .name = "susfs",
+        /*
+         * The SuSFS module reads its configuration while it mounts at
+         * boot, so a change made here only lands on the next boot.
+         */
+        .caps = KSU_EXTENSION_FLAG_REBOOT,
+        .ops = &ksu_extension_susfs_ops,
+    };
+
+    static const struct ksu_extension_handler version_spoof_handler = {
+        .extension_id = KSU_EXTENSION_VERSION_SPOOF,
+        .name = "version_spoof",
+        /* Applied to the running kernel immediately by the io handler. */
+        .caps = 0,
+        .ops = NULL,
+        .io_handler = ksu_extension_version_spoof_io,
+        .wipe = ksu_extension_version_spoof_wipe,
+    };
+
+    if (ksu_register_extension_handler(&kpm_handler))
+        pr_err("extension: failed to register kpm\n");
+    if (ksu_register_extension_handler(&cpu_spoof_handler))
+        pr_err("extension: failed to register cpu_spoof\n");
+    if (ksu_register_extension_handler(&umount_paths_handler))
+        pr_err("extension: failed to register umount_paths\n");
+    if (ksu_register_extension_handler(&dynamic_manager_handler))
+        pr_err("extension: failed to register dynamic_manager\n");
+    if (ksu_register_extension_handler(&susfs_handler))
+        pr_err("extension: failed to register susfs\n");
+    if (ksu_register_extension_handler(&version_spoof_handler))
+        pr_err("extension: failed to register version_spoof\n");
+
+    /* Publish: any future ksu_extension_apply_forced() is now safe.
+     * The release-store pairs with the acquire-load in
+     * ksu_extension_apply_forced() so that, on the calling CPU,
+     * the four ksu_register_extension_handler() writes above are
+     * visible before the flag is observed as set. */
+    smp_wmb();
+    WRITE_ONCE(extensions_registered, true);
+}
+
+void __exit ksu_extension_exit(void)
+{
+    mutex_lock(&extension_mutex);
+    memset(extension_handlers, 0, sizeof(extension_handlers));
+    mutex_unlock(&extension_mutex);
+    pr_info("extension: subsystem cleaned up\n");
+}
diff --git a/EXTRA/KernelSU/kernel/extension/extension.h b/EXTRA/KernelSU/kernel/extension/extension.h
new file mode 100644
index 00000000..f3d5ce97
--- /dev/null
+++ b/EXTRA/KernelSU/EXTRA/KernelSU/kernel/extension/extension.h
@@ -0,0 +1,228 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __KSU_H_EXTENSION
+#define __KSU_H_EXTENSION
+
+#include <linux/types.h>
+#include <linux/mutex.h>
+#include <linux/errno.h>
+
+/*
+ * An extension is a KernelSU subsystem richer than a single bit. Each
+ * registers a handler; the kernel keeps a table indexed by extension_id,
+ * dispatched through KSU_IOCTL_EXTENSION.
+ *
+ * Flavours:
+ *   - value      : sticky enable bit via get/set ops. DYNAMIC_MANAGER.
+ *                  KSU_EXTENSION_SET calls ops->set; KSU_EXTENSION_GET
+ *                  calls ops->get.
+ *   - io + get   : exposes a runtime GET (e.g. CONFIG_KPM presence) but
+ *                  has no runtime SET. KSU_EXTENSION_SET returns
+ *                  -EOPNOTSUPP. KPM.
+ *   - io only    : no sticky bit at all; io_handler forwards raw user
+ *                  payloads. CPU_SPOOF, UMOUNT_PATHS, VERSION_SPOOF.
+ *
+ * The flavour is published to userspace as capability bits
+ * (KSU_EXTENSION_FLAG_*) rather than inferred from which callbacks happen
+ * to be non-NULL. Registration cross-checks the two representations, so a
+ * table that claims STICKY without a setter is rejected instead of
+ * producing a toggle the kernel would answer with -EOPNOTSUPP.
+ *
+ * Forced-by-config (force_extension=<id>:<value>) is replayed on every
+ * boot: value-flavoured handlers go through ops->set; io-flavoured
+ * handlers (including io + get) go through apply_forced. A handler with
+ * neither refuses to be forced (warning + clear pending) — this is a
+ * deliberate refusal, not a bug. The old io_handler(id, NULL) fallback
+ * was unsafe (subsystem-dependent NULL semantics) and is no longer
+ * used.
+ *
+ * Wipe (KSU_EXTENSION_WIPE) goes through handler->wipe, a
+ * kernel-side callback. A handler with no wipe returns -EOPNOTSUPP.
+ * Wipe is independent of apply_forced. Wipe is also refused while a
+ * force_extension=<id> is in effect, to keep the locked state
+ * consistent with userspace SET.
+ */
+
+struct ksu_extension_handler;
+
+typedef int (*ksu_extension_get_value_fn)(u32 extension_id, u64 *value);
+typedef int (*ksu_extension_set_value_fn)(u32 extension_id, u64 value);
+
+struct ksu_extension_handler_ops {
+    /* read sticky enable bit. KSU_EXTENSION_OP_GET. */
+    ksu_extension_get_value_fn get;
+    /* write sticky enable bit. KSU_EXTENSION_OP_SET. */
+    ksu_extension_set_value_fn set;
+};
+
+/*
+ * The end-of-payload op handler. Receives the user pointer as it was
+ * supplied by userspace, plus an opaque cookie (the extension id). Used by
+ * the io-flavoured extensions (CPU_SPOOF, UMOUNT_LIST, DYNAMIC_MANAGER).
+ *
+ * Returns negative errno on failure; length copied on success.
+ */
+typedef int (*ksu_extension_io_fn)(u32 extension_id, void __user *arg);
+
+/*
+ * Forced-by-config callback. Invoked by ksu_extension_apply_forced()
+ * to apply a saved value to an io-flavoured handler on every boot.
+ *
+ * Kernel-side entry point: the value is extension_forced_values[id] (raw u64,
+ * never a userspace pointer). No access_ok, no copy_from_user.
+ * io_handler() is strictly a userspace entry point and must not
+ * branch on "this is a forced sentinel".
+ */
+typedef void (*ksu_extension_apply_forced_fn)(u32 extension_id, u64 value);
+
+/*
+ * Wipe callback. Invoked by ksu_extension_wipe() to clear an
+ * extension's runtime state. Kernel-side; no userspace pointer.
+ */
+typedef int (*ksu_extension_wipe_fn)(u32 extension_id);
+
+struct ksu_extension_handler {
+    u32 extension_id;
+    const char *name;
+    /*
+     * Semantic capability bits (KSU_EXTENSION_FLAG_*) advertised through
+     * cmd.supported. The dispatcher adds KSU_FEATURE_FLAG_SUPPORTED (and
+     * FORCED when applicable) itself, so neither may appear here:
+     * registration rejects them as a table bug.
+     *
+     * This is the only place an extension declares what it can do. The
+     * manager and ksud read it back instead of keeping a mirror table,
+     * which is what used to drift whenever a handler gained a setter.
+     */
+    u32 caps;
+    /*
+     * Extension ABI version a caller must speak to use this handler.
+     * Callers advertising an older version get -EOPNOTSUPP, so a handler
+     * that changed its payload layout never has to parse a struct the
+     * caller could not have built. 0 = no requirement.
+     *
+     * Callers that predate KSU_EXTENSION_ABI send api_version 0 and are
+     * treated as ABI 1, which is the version every handler in this tree
+     * was written against.
+     */
+    u32 min_api_version;
+    /* required */
+    const struct ksu_extension_handler_ops *ops;
+    /* optional, used by io-flavoured extensions */
+    ksu_extension_io_fn io_handler;
+    /* optional, used by io-flavoured extensions to apply a forced value */
+    ksu_extension_apply_forced_fn apply_forced;
+    /* optional, used to clear runtime state on KSU_EXTENSION_WIPE */
+    ksu_extension_wipe_fn wipe;
+};
+
+int ksu_register_extension_handler(const struct ksu_extension_handler *handler);
+int ksu_unregister_extension_handler(u32 extension_id);
+
+/*
+ * Called by the supercall dispatcher. `caller_api_version` is
+ * ksu_extension_cmd.api_version as supplied by userspace.
+ *
+ * On success *caps receives the handler's semantic capability bits plus
+ * KSU_FEATURE_FLAG_SUPPORTED. FORCED is not included: it is global state
+ * that changes while a handler is registered, so the dispatcher adds it at
+ * reply time. *caps is 0 when no handler is registered for the id; callers
+ * must treat that as "unsupported" instead of calling GET and hoping.
+ *
+ * Returns -EOPNOTSUPP when the caller's ABI is older than the handler
+ * requires; a gate failure is indistinguishable from "no handler" on
+ * purpose, because from the caller's point of view the extension is not
+ * usable either way.
+ */
+int ksu_extension_get(u32 extension_id, u32 caller_api_version, u64 *value, u32 *caps);
+int ksu_extension_set(u32 extension_id, u32 caller_api_version, u64 value);
+
+/*
+ * Dispatch an extension io-flavored op. The `raw` pointer is forwarded to
+ * handler->io_handler unchanged.
+ */
+int ksu_extension_ioctl(u32 extension_id, u32 caller_api_version, void __user *raw);
+
+/* Wipe an extension's state. Used by KSU_EXTENSION_WIPE. */
+int ksu_extension_wipe(u32 extension_id, u32 caller_api_version);
+
+/*
+ * Fill `desc` with the handler at zero-based `index` among registered
+ * handlers (gaps in the id space are skipped). Used by
+ * KSU_EXTENSION_ENUM so userspace does not keep a mirror of the handler
+ * table. Returns -ENOENT once index is past the last handler.
+ *
+ * `desc->caps` already includes KSU_FEATURE_FLAG_SUPPORTED; FORCED is
+ * reported separately in `desc->forced` because it is boot state.
+ */
+int ksu_extension_enumerate(u32 index, struct ksu_extension_desc *desc);
+
+/* Force an extension to be present. Used by force_feature= extension:<id>. */
+bool ksu_extension_is_forced(u32 extension_id);
+
+/* Lifecycle: called from ksu_feature_apply_forced. */
+void ksu_extension_apply_forced(void);
+
+void ksu_extension_init(void);
+void ksu_extension_exit(void);
+void ksu_extension_register_all(void);
+
+/*
+ * Force-value encoding for io-flavoured handlers.
+ *
+ * This is the kernel-internal ABI between `force_extension_param_set()`
+ * and the per-handler `apply_forced` callback. It is NOT a UAPI: the
+ * u64 never crosses the user/kernel boundary on this code path.
+ *
+ * # Encoding
+ *
+ *   force_extension=<id>:<value>
+ *
+ * <id>   = enum ksu_extension_id (decimal or hex)
+ * <value>= u64, parsed by the kernel's kstrtou64() (decimal, 0x hex,
+ *           0 octal). The value's meaning is per-extension:
+ *     - value-flavoured handlers (DYNAMIC_MANAGER) treat <value> as
+ *       the sticky bit (0 or 1) and replay it through ops->set().
+ *     - io-flavoured handlers (KPM) may pack a (sub-op, arg) tuple
+ *       into the u64 using the KSU_EXTENSION_FORCE_* macros below.
+ *
+ * # Replay order
+ *
+ *   1. ops->set      — value-flavoured handlers, replay the raw u64
+ *                       extension_forced_values[id].
+ *   2. apply_forced  — io-flavoured handlers, kernel-side callback
+ *                       that receives the raw u64. No user pointer
+ *                       is fabricated.
+ *   3. neither       — log and clear forced_pending. This is a
+ *                       deliberate refusal, not a bug. The old
+ *                       io_handler(id, NULL) fallback was unsafe
+ *                       (NULL is WIPE for umount_paths, EFAULT for
+ *                       others) and is no longer used.
+ *
+ * # Single source of truth
+ *
+ * Boot config producers (bootloaders, ksud) only need to know the
+ * encoding if they intentionally compose a 32-bit sub-op with a 32-bit
+ * arg, which is rare. Single-sub-op forces like
+ * `force_extension=kpm:7` are the common case and are unaffected.
+ *
+ * To keep producers and consumers in lockstep, this header is the
+ * single source of truth. New sub-op authors MUST use these macros
+ * instead of hand-rolling the bit shifts:
+ *
+ *   u64 v = KSU_EXTENSION_FORCE_PACK(7, 0x42);
+ *   if (KSU_EXTENSION_FORCE_OP(v) != SUKISU_KPM_VERSION) ...;
+ *   do_thing_with(KSU_EXTENSION_FORCE_ARG(v));
+ *
+ * # Stability
+ *
+ * The (op, arg) split direction is part of the ABI: op occupies the
+ * low 32 bits, arg the high 32 bits. Changing either direction
+ * silently corrupts every force entry; bump the encoding version
+ * (or just don't change it) if you ever need to.
+ */
+#define KSU_EXTENSION_FORCE_OP(value) ((u32)((value) & 0xffffffffu))
+#define KSU_EXTENSION_FORCE_ARG(value) ((u32)((value) >> 32))
+#define KSU_EXTENSION_FORCE_PACK(op, arg) \
+    (((u64)(u32)(op)) | (((u64)(u32)(arg)) << 32))
+
+#endif /* __KSU_H_EXTENSION */
diff --git a/EXTRA/KernelSU/kernel/extension/kpm.c b/EXTRA/KernelSU/kernel/extension/kpm.c
new file mode 100644
index 00000000..c99d16a3
--- /dev/null
+++ b/EXTRA/KernelSU/EXTRA/KernelSU/kernel/extension/kpm.c
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * KPM extension wiring. Connects KSU_EXTENSION_KPM to the KPM
+ * control surface (kernel/extension/kpm/kpm.c).
+ *
+ * Sticky get: CONFIG_KPM -> 1, else 0. No sticky set; userspace
+ * KSU_EXTENSION_SET returns -EOPNOTSUPP.
+ *
+ * Forced-by-config (force_extension=kpm:<value>) goes through
+ * handler->apply_forced. The u64 is decoded as
+ *   sub-op = (u32)(value & 0xffffffff)
+ *   arg    = (u32)(value >> 32)
+ *
+ * IMPORTANT: this is a *kernel-internal* ABI between
+ * `force_extension_param_set()` and the per-handler `apply_forced`
+ * callback. The u64 is never visible to userspace in this code
+ * path. The bootloader-side `force_extension=kpm:<value>` is the
+ * only producer and is parsed by `kstrtou64(0)`; humans typing
+ * this in a boot config will not encounter the (op, arg) split
+ * unless they intentionally compose a 64-bit value with a 32-bit
+ * sub-op in the low half. (Such a value is meaningful only for
+ * sub-ops that actually consume `arg`; today only SUKISU_KPM_VERSION
+ * is recognised, and it ignores the arg.)
+ *
+ * New sub-op authors:
+ *   - If your sub-op does not need an argument, do nothing special.
+ *     Document the literal value (e.g. `force_extension=kpm:7`).
+ *   - If your sub-op DOES need an argument, never write the
+ *     `(u32)(value & 0xffffffff)` / `>> 32` bit-twiddling inline.
+ *     Use the helpers below — they are the single source of truth
+ *     for the encoding, kept in lockstep with the decoder.
+ *
+ * IMPORTANT: this callback is a *probe*, not an enable hook. KPM
+ * availability is fixed at kernel build time (CONFIG_KPM) and cannot
+ * be flipped at runtime from the extension hub. force_extension=kpm:1
+ * (or any other sub-op) does not load a KPM module, start the KPM
+ * watcher, or otherwise alter runtime state. The only recognised
+ * sub-op is SUKISU_KPM_VERSION (a no-op dmesg probe that prints
+ * whether CONFIG_KPM is on); any other sub-op is a no-op + warning
+ * and clears the forced-pending bit because the value has been
+ * consumed. If you want a real "force KPM" knob, wire it through
+ * ksud's kpm boot stage instead.
+ *
+ * The userspace ioctl entry point (ksu_extension_kpm_io) is unchanged.
+ */
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/uaccess.h>
+
+#include "kpm/kpm.h"
+#include "kpm/bridge.h"
+
+int ksu_extension_kpm_get(u32 id, u64 *value)
+{
+#ifdef CONFIG_KPM
+    *value = sukisu_kpm_bridge(SUKISU_KPM_PROBE, 0, 0, 0, 0) == SUKISU_KPM_ABI_VERSION;
+#else
+    *value = 0;
+#endif
+    return 0;
+}
+
+const struct ksu_extension_handler_ops ksu_extension_kpm_ops = {
+    .get = ksu_extension_kpm_get,
+};
+
+int ksu_extension_kpm_io(u32 id, void __user *raw)
+{
+#ifdef CONFIG_KPM
+    return do_kpm(raw);
+#else
+    (void)raw;
+    pr_warn_once("extension/kpm: IO disabled: rebuild SukiSU with CONFIG_KPM=y\n");
+    return -EOPNOTSUPP;
+#endif
+}
+
+void ksu_extension_kpm_apply_forced(u32 id, u64 value)
+{
+    /*
+     * Decode using the shared macros in extension.h. The decode
+     * direction is part of the kernel-internal ABI; if you change
+     * it, also update the KSU_EXTENSION_FORCE_* macros. Today no
+     * other consumer exists, so changing one without the other
+     * would silently corrupt every KPM force entry.
+     */
+    u32 op = KSU_EXTENSION_FORCE_OP(value);
+    u32 arg = KSU_EXTENSION_FORCE_ARG(value);
+
+    switch (op) {
+    case SUKISU_KPM_VERSION:
+#ifdef CONFIG_KPM
+        pr_info("extension/kpm: forced VERSION probe, KPM is built in (arg=%u)\n", arg);
+#else
+        pr_warn("extension/kpm: forced VERSION probe, KPM is *not* built in (arg=%u)\n", arg);
+#endif
+        return;
+    default:
+        pr_warn("extension/kpm: forced op=%u arg=%u not honoured\n", op, arg);
+        return;
+    }
+}

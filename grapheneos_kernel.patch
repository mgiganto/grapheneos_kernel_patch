+}
+#define __open_impl(path, flags, mode, ...) __sys_openat(path, flags, mode)
+#define open(path, flags, ...) __open_impl(path, flags, ##__VA_ARGS__, 0)
+
+#if defined(__arm__) // map to fstatat64

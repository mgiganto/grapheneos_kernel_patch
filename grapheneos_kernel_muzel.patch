diff --git a/EXTRA/KernelSU/kernel/klog.h b/EXTRA/KernelSU/kernel/klog.h
new file mode 100644
index 00000000..852c1a3a
--- /dev/null
+++ b/EXTRA/KernelSU/EXTRA/KernelSU/kernel/klog.h
@@ -0,0 +1,15 @@
+#ifndef __KSU_H_KLOG
+#define __KSU_H_KLOG
+
+#include <linux/printk.h>
+
+extern void write_sulog(uint8_t sym);
+extern int send_sulog_dump(void __user *uptr);
